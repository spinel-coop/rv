#!/bin/bash
set -euo pipefail

RUBY_VERSION="3.4.7"
cargo build --bin rv --bin rvx
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RV="$DIR/target/debug/rv"

cleanup() {
    rm -rf fmt-test doctest-test
    rm -f .ruby-version
}
trap cleanup EXIT

echo "=== rv run --ruby $RUBY_VERSION ruby (install + execute) ==="
output=$($RV run --ruby "$RUBY_VERSION" ruby -e 'puts RUBY_DESCRIPTION')
echo "  $output"
echo "$output" | grep -q "$RUBY_VERSION"
echo "PASS: rv run ruby installed and executed Ruby $RUBY_VERSION"

echo "=== rv ruby list --installed-only ==="
list=$($RV ruby list --installed-only)
echo "$list"
echo "$list" | grep -q "$RUBY_VERSION"
echo "PASS: rv ruby list shows installed $RUBY_VERSION"

echo "=== rv ruby list --installed-only --format json ==="
json=$($RV ruby list --installed-only --format json)
echo "$json"
echo "$json" | grep -q '"version"'
echo "PASS: rv ruby list --format json outputs valid JSON"

echo "=== rv ruby find $RUBY_VERSION ==="
find_output=$($RV ruby find "$RUBY_VERSION")
echo "  $find_output"
echo "$find_output" | grep -q "ruby"
echo "PASS: rv ruby find returns a path to ruby"

echo "=== rv ruby pin $RUBY_VERSION ==="
$RV ruby pin "$RUBY_VERSION"
pin=$(cat .ruby-version)
echo "  .ruby-version contains: $pin"
echo "$pin" | grep -q "$RUBY_VERSION"
echo "PASS: rv ruby pin writes correct .ruby-version"

echo "=== rv shell env bash ==="
env_out=$($RV shell env bash)
echo "$env_out"
echo "$env_out" | grep -q "RUBY_ROOT"
echo "$env_out" | grep -q "export PATH="
echo "PASS: rv shell env bash outputs RUBY_ROOT and PATH exports"

echo "=== rv cache dir ==="
cache=$($RV cache dir)
echo "  $cache"
[ -n "$cache" ]
echo "PASS: rv cache dir prints a non-empty path"

echo "=== rv ruby uninstall $RUBY_VERSION ==="
$RV ruby uninstall "$RUBY_VERSION"
echo "PASS: rv ruby uninstall exits without error"

echo "=== Verify $RUBY_VERSION is no longer listed ==="
list_after=$($RV ruby list --installed-only 2>/dev/null || true)
if echo "$list_after" | grep -q "$RUBY_VERSION.*installed"; then
    echo "FAIL: $RUBY_VERSION still appears as installed after uninstall"
    exit 1
fi
echo "PASS: $RUBY_VERSION no longer listed after uninstall"

echo "=== rv run --ruby $RUBY_VERSION ruby (re-install after uninstall) ==="
$RV run --ruby "$RUBY_VERSION" ruby -e 'puts "re-installed"' | grep -q "re-installed"
echo "PASS: re-installs and runs after uninstall"

echo "=== rv doctest (valid fenced example) ==="
mkdir -p doctest-test
echo "$RUBY_VERSION" > doctest-test/.ruby-version
cat > doctest-test/greeter.rb <<'RUBY'
# A greeter.
class Greeter
  # Greets someone by name.
  #
  # ```ruby
  # greeter = Greeter.new
  # puts greeter.greet("World")
  # ```
  def greet(name)
    "Hello, #{name}!"
  end
end
RUBY
(
    cd doctest-test
    out=$($RV doctest)
    echo "  $out"
    echo "$out" | grep -q "pass checks"
)
echo "PASS: rv doctest accepts a valid fenced example"

echo "=== rv doctest (minitest assertion in fenced example) ==="
cat > doctest-test/adder.rb <<'RUBY'
# Adds numbers.
class Adder
  # Adds two numbers.
  #
  # ```ruby
  # require "minitest/autorun"
  # def add(a, b) = a + b
  # assert_equal 3, add(1, 2)
  # ```
  def add(a, b)
    a + b
  end
end
RUBY
(
    cd doctest-test
    out=$($RV doctest)
    echo "  $out"
    echo "$out" | grep -q "pass checks"
)
echo "PASS: rv doctest runs minitest assertions in fenced examples"

echo "=== rv doctest (single file argument) ==="
(
    cd doctest-test
    out=$($RV doctest greeter.rb)
    echo "  $out"
    echo "$out" | grep -q "in 1 file pass checks"
)
echo "PASS: rv doctest checks a single named file"

echo "=== rv doctest --rbs (coverage summary) ==="
mkdir -p doctest-test/sig
cat > doctest-test/sig/greeter.rbs <<'RBS'
class Greeter
  def greet: (String name) -> String
end
RBS
(
    cd doctest-test
    out=$($RV doctest --rbs=stat greeter.rb)
    echo "$out"
    echo "$out" | grep -q "RBS coverage:"
)
echo "PASS: rv doctest --rbs prints an RBS coverage summary"

echo "=== rv doctest (syntax error in fenced example) ==="
cat > doctest-test/broken.rb <<'RUBY'
# Has a broken example.
class Broken
  # Broken example.
  #
  # ```ruby
  # def oops(
  # ```
  def oops
    1
  end
end
RUBY
(
    cd doctest-test
    if out=$($RV doctest broken.rb 2>&1); then
        echo "$out"
        echo "FAIL: rv doctest exited 0 despite a syntax error"
        exit 1
    fi
    echo "$out" | grep -q "broken.rb"
    echo "$out" | grep -q "syntax"
)
echo "PASS: rv doctest fails on a fenced example that does not parse"

echo "=== rv doctest (failing minitest assertion) ==="
cat > doctest-test/wrong.rb <<'RUBY'
# Has a wrong example.
class Wrong
  # Wrong example.
  #
  # ```ruby
  # require "minitest/autorun"
  # def add(a, b) = a + b
  # assert_equal 99, add(1, 2)
  # ```
  def add(a, b)
    a + b
  end
end
RUBY
(
    cd doctest-test
    if out=$($RV doctest wrong.rb 2>&1); then
        echo "$out"
        echo "FAIL: rv doctest exited 0 despite a failing assertion"
        exit 1
    fi
    echo "$out" | grep -q "wrong.rb"
)
echo "PASS: rv doctest fails on a failing minitest assertion"

echo "=== rv doctest (unreadable path) ==="
(
    cd doctest-test
    if out=$($RV doctest no-such-file.rb 2>&1); then
        echo "$out"
        echo "FAIL: rv doctest exited 0 for a nonexistent path"
        exit 1
    fi
    echo "  $out"
    echo "$out" | grep -q "no-such-file.rb"
)
echo "PASS: rv doctest fails on a path that cannot be read"

rm -rf doctest-test

[ -t 1 ] || exit 0

echo "=== rv fmt (stdin formatting to stdout) ==="
echo "class Hello; end" | $RV fmt > hello.rb
result="$(cat hello.rb)"
rm hello.rb
if [[ "$result" != "$(printf 'class Hello\nend\n')" ]]; then
    echo "FAIL: stdin formatted to $result"
    exit 1
fi
echo "PASS: stdin formatted on stdout"

echo "=== rv fmt . (formatting a directory in place) ==="
mkdir fmt-test
echo "class Hello; end" > fmt-test/hello.rb
(
    cd fmt-test
    $RV fmt .
)
result="$(cat fmt-test/hello.rb)"
rm -rf fmt-test
if [[ "$result" != "$(printf 'class Hello\nend\n')" ]]; then
    echo "FAIL: stdin formatted to $result"
    exit 1
fi
echo "PASS: file formatted in place"

echo "=== rv fmt (formatting PWD by default) ==="
mkdir fmt-test
echo "class Hello; end" > fmt-test/hello.rb
(
    cd fmt-test
    $RV fmt
)
result="$(cat fmt-test/hello.rb)"
rm -rf fmt-test
if [[ "$result" != "$(printf 'class Hello\nend\n')" ]]; then
    echo "FAIL: fmt-test/hello.rb didn't format; was '$result'"
    exit 1
fi
echo "PASS: file formatted in place"

echo "=== rv fmt (ignoring stdin while formatting a directory) ==="
mkdir fmt-test
echo "class Hello; end" > fmt-test/hello.rb
(
    cd fmt-test
    echo "class Bad" | $RV fmt .
)
result="$(cat fmt-test/hello.rb)"
rm -rf fmt-test
if [[ "$result" != "$(printf 'class Hello\nend\n')" ]]; then
    echo "FAIL: fmt-test/hello.rb didn't format; was '$result'"
    exit 1
fi
echo "PASS: file formatted in place"

echo "=== rvx --with ==="
rvx --with pg sequel -c "require 'pg'; puts PG::VERSION"
echo "PASS: installs the named gem and the with gem"

echo "=== rv tool run --with ==="
rv tool run --with pg sequel -c "require 'pg'; puts PG::VERSION"
echo "PASS: installs the named gem and the with gem"
